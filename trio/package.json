{
  "name": "simple-trio",
  "author": "Eduardo Chiaro",
  "version": "1.4.0",
  "keywords": [
    "pebble-app",
    "watchface",
    "simple"
  ],
  "private": true,
  "scripts": {
    "build": "pebble build",
    "clean": "pebble clean",
    "emulator": "npm run clean && npm run build && pebble install --emulator ",
    "phone": "npm run clean && npm run build && pebble install --phone",
    "config": "pebble emu-app-config --emulator",
    "logs": "pebble logs --emulator",
    "tap": "pebble emu-tap --direction y+ --emulator"
  },
  "dependencies": {
    "@rebble/clay": "^1.0.10"
  },
  "pebble": {
    "displayName": "Simple Trio",
    "uuid": "c301b932-4ec7-422c-a425-bdf236681ceb",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "aplite",
      "basalt",
      "chalk",
      "diorite",
      "emery",
      "flint",
      "gabbro"
    ],
    "watchapp": {
      "watchface": true
    },
    "messageKeys": [
      "INVERT_COLORS"
    ],
    "resources": {
      "media": [
        {
          "menuIcon": "true",
          "type": "png",
          "name": "MENU_ICON",
          "file": "icon.png"
        },
        {
          "type": "raw",
          "name": "NUMBER_6",
          "file": "6.pdc"
        },
        {
          "type": "raw",
          "name": "NUMBER_2",
          "file": "2.pdc"
        },
        {
          "type": "raw",
          "name": "NUMBER_10",
          "file": "10.pdc"
        }
      ]
    },
    "capabilities": [
      "configurable"
    ]
  }
}
