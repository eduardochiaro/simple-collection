{
  "name": "simple-askew",
  "author": "Eduardo Chiaro",
  "version": "1.0.0",
  "keywords": [
    "pebble-app",
    "watchface",
    "simple"
  ],
  "private": true,
  "scripts": {
    "build": "pebble build",
    "clean": "pebble clean",
    "emulator": "npm run clean && npm run build && pebble install --emulator ",
    "phone": "npm run clean && npm run build && pebble install --phone ",
    "config": "pebble emu-app-config --emulator ",
    "logs": "pebble logs --emulator ",
    "tap": "pebble emu-tap --direction y+ --emulator "
  },
  "dependencies": {
    "@rebble/clay": "^1.0.8"
  },
  "pebble": {
    "displayName": "Simple Askew",
    "uuid": "b8fb089f-28ae-447c-acce-f21f82509ffe",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "aplite",
      "basalt",
      "chalk",
      "diorite",
      "emery",
      "flint",
      "gabbro"
    ],
    "watchapp": {
      "watchface": true
    },
    "messageKeys": [
      "ANGLE"
    ],
    "resources": {
      "media": [
        {
          "type": "bitmap",
          "name": "TEXT_PEBBLE_0",
          "file": "images/text_pebble_0.png"
        },
