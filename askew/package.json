{
  "name": "simple-askew",
  "author": "Eduardo Chiaro",
  "version": "1.0.0",
  "keywords": [
    "pebble-app",
    "watchface",
    "simple"
  ],
  "private": true,
  "scripts": {
    "build": "pebble build",
    "clean": "pebble clean",
    "emulator": "npm run clean && npm run build && pebble install --emulator ",
    "phone": "npm run clean && npm run build && pebble install --phone",
    "config": "pebble emu-app-config --emulator",
    "logs": "pebble logs --emulator",
    "tap": "pebble emu-tap --direction y+ --emulator"
  },
  "dependencies": {},
  "pebble": {
    "displayName": "Simple Askew",
    "uuid": "b8fb089f-28ae-447c-acce-f21f82509ffe",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "aplite",
      "basalt",
      "chalk",
      "diorite",
      "emery",
      "flint",
      "gabbro"
    ],
    "watchapp": {
      "watchface": false
    },
    "messageKeys": [
      "dummy"
    ],
    "resources": {
      "media": [
        {"type": "bitmap", "name": "TEXT_PEBBLE_10", "file": "images/text_pebble_10.png"},
        {"type": "bitmap", "name": "TEXT_PEBBLE_15", "file": "images/text_pebble_15.png"},
        {"type": "bitmap", "name": "TEXT_PEBBLE_20", "file": "images/text_pebble_20.png"},
        {"type": "bitmap", "name": "TEXT_PEBBLE_25", "file": "images/text_pebble_25.png"},
        {"type": "bitmap", "name": "TEXT_PEBBLE_30", "file": "images/text_pebble_30.png"}
      ]
    }
  }
}
